<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Spelled out rather than $(PRODUCT_NAME): this is the name under the icon and on the store
	     listing, and it is constrained by what is registered. It must not silently follow a build
	     setting. The INFOPLIST_KEY_CFBundleDisplayName build setting cannot do this job — it only
	     applies when GENERATE_INFOPLIST_FILE is YES, and this target ships a hand-written plist,
	     so the key was absent from every build until now. -->
	<key>CFBundleDisplayName</key>
	<string>Just-Go</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- canOpenURL returns false for any scheme not listed here, whatever is installed, so a
	     handoff button would silently offer nothing. It has to live in this file: the
	     INFOPLIST_KEY_* build settings only apply when GENERATE_INFOPLIST_FILE is YES, and this
	     target ships a hand-written plist — the same trap that kept CFBundleDisplayName out of
	     every build above.

	     Declaring a scheme is a query, not a capability: it lets the app ask whether a map or
	     hailing app is installed so it can offer the right button, and nothing more. Each has an
	     https fallback for riders who have none of them, which is the only path testable without
	     a device — no simulator has any of these apps installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>baidumap</string>
		<string>iosamap</string>
		<string>diditaxi</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>BaiduMapsAK</key>
	<string>$(BAIDU_MAPS_AK)</string>
	<key>BaiduMapsSK</key>
	<string>$(BAIDU_MAPS_SK)</string>
	<key>CityPackBaseURL</key>
	<string>$(CITY_PACK_BASE_URL)</string>
	<key>CityPackFallbackBaseURL</key>
	<string>$(CITY_PACK_FALLBACK_BASE_URL)</string>
	<key>CityPackMainlandMirrorURL</key>
	<string>$(CITY_PACK_MAINLAND_MIRROR_URL)</string>
	<key>CityPackManifestURL</key>
	<string>$(CITY_PACK_MANIFEST_URL)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Just-Go needs your location to find nearby subway stations and provide navigation.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
